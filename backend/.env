# Paddeli Backend Configuration
PROJECT_NAME=Paddeli API
VERSION=1.0.0
API_V1_STR=/api
ENVIRONMENT=development

# Database Connection (MilesWeb MySQL)
# Leave empty or set your MilesWeb MySQL connection string, e.g.:
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost/<DB_NAME>
DATABASE_URL=

# JWT Security
SECRET_KEY=9f8e7d6c5b4a3210123456789abcdef0123456789abcdef0123456789abcdef0
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-party Integrations (Optional / Placeholders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FIREBASE_PROJECT_ID=
