# Coconut Plucker Backend Configuration

PROJECT_NAME=Coconut Plucker API
VERSION=1.0.0
API_V1_STR=/api
ENVIRONMENT=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coconut_plucker

# JWT Security
SECRET_KEY=temporary_secret_key_change_in_production_min_32_bytes_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-party Integrations (Optional / Placeholders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FIREBASE_PROJECT_ID=
