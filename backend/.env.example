# Paddeli Backend Configuration

PROJECT_NAME=Paddeli API
VERSION=1.0.0
API_V1_STR=/api
ENVIRONMENT=production

# Database Connection (MilesWeb MySQL)
# DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost/<DB_NAME>
DATABASE_URL=

# JWT Security (Set a 64+ char random secret in server .env)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional initial bootstrap passwords (used ONLY if admin user has no password_hash yet)
DEFAULT_SUPER_ADMIN_PASSWORD=
DEFAULT_ADMIN_PASSWORD=

# Third-party Integrations (Razorpay server verification & Checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FIREBASE_PROJECT_ID=

# SMTP Email Settings (Configure cPanel Email credentials on server)
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USER=contact@paddeli.com
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
NOTIFICATION_EMAIL=contact@paddeli.com
MAIL_FROM=Paddeli <contact@paddeli.com>
