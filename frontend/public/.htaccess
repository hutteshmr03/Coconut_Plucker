DirectoryIndex index.html

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/nrlnxfke/paddeli_api"
PassengerBaseURI "/api"
PassengerPython "/home/nrlnxfke/virtualenv/paddeli_api/3.10/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow Passenger to handle /api requests
  RewriteRule ^api - [L]

  # 2. Serve static assets and files directly if they exist
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Never rewrite missing /assets/* files to index.html; route other SPA paths to index.html
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteRule ^ index.html [L]
</IfModule>
